def shotcheck(path):
    script = REPO / "tools" / "shotcheck.py"
    if not script.exists():
        return None
    try:
        proc = subprocess.run([sys.executable, str(script), path],
                              capture_output=True, text=True, timeout=60)
    except (OSError, subprocess.TimeoutExpired):
        return None
    text = (proc.stdout or proc.stderr).strip()
    return text or None


def call_tool(name, args, channel, session):
    if name == "goanna_session":
        action = args.get("action", "status")
        out = {}
        if action == "status":
            session.reap()
            if not channel.up():
                # Say which of the two it is. A client that exited and one that
                # is wedged both fail to answer, and they want opposite
                # responses: start a new one, or go and look at why the old one
                # is stuck.
                if session.proc is None:
                    return {"running": False,
                            "hint": "no client is answering; goanna_session action=start"}
                return {"running": False, "pid": session.proc.pid,
                        "hint": "the process is alive but not answering on the control "
                                "channel: it is wedged rather than gone. Look at it before "
                                "restarting, and see docs/control-channel.md for the "
                                "overlay that says what it was last asked to do."}
            return dict(channel.send("status"), running=True)
        if action in ("start", "restart") and args.get("build"):
            out.update(session.build())
        if action in ("stop", "restart"):
            out.update(session.stop(channel))
        if action == "stop":
            return out
        if action in ("start", "restart"):
            out.update(session.start(channel, host=args.get("host"), port=args.get("port"),
                                     name=args.get("name"), env=args.get("env")))
            return out
        raise ChannelError("unknown action '%s'" % action)

    if name == "goanna_status":
        return dict(channel.send("status"), deviations=channel.send("deviations"))

    if name == "goanna_view":
        out = {}
        if "teleport" in args:
            out["teleport"] = channel.send("tp", vec(args["teleport"], "teleport"))
        pose = {}
        if "position" in args:
            pose.update(vec(args["position"], "position"))
        for key in ("pitch", "yaw", "fly"):
            if key in args:
                pose[key] = args[key]
        if pose:
            out["pose"] = channel.send("pose", pose)
        if "look_at" in args:
            out["look"] = channel.send("look", vec(args["look_at"], "look_at"))
        if not out:
            raise ChannelError("goanna_view wants teleport, position, look_at, pitch, yaw or fly")
        return out

    if name == "goanna_world":
        out = {}
        if "time" in args:
            out["time"] = channel.send("time", {"tod": args["time"],
                                                "server": bool(args.get("time_on_server"))})
        if "weather" in args:
            out["weather"] = channel.send("weather", {"kind": args["weather"],
                                                      "fake": bool(args.get("fake_weather"))})
        if "give" in args:
            out["give"] = channel.send("give", {"item": args["give"],
                                                "count": int(args.get("count", 1))})
        if "spawn" in args:
            spawn = {"name": args["spawn"], "count": int(args.get("count", 1))}
            if "at" in args:
                spawn.update(vec(args["at"], "at"))
            out["spawn"] = channel.send("spawn", spawn)
        if "chat" in args:
            out["chat"] = channel.send("chat", {"text": args["chat"]})
        if not out:
            raise ChannelError("goanna_world wants time, weather, give, spawn or chat")
        return out

    if name == "goanna_settings":
        action = args.get("action")
        if action == "list":
            return channel.send("settings")
        if action == "get":
            return channel.send("get", {"key": args.get("key", "")})
        if action == "set":
            if "value" not in args:
                raise ChannelError("set wants a value")
            return channel.send("set", {"key": args.get("key", ""), "value": args["value"]})
        raise ChannelError("goanna_settings wants action get, set or list")

    if name == "goanna_shot":
        path = args.get("path")
        if not path:
            LOG_DIR.mkdir(parents=True, exist_ok=True)
            path = str(LOG_DIR / ("shot-%d.png" % int(time.time() * 1000)))
        shot = {"path": path}
        for key in ("settle", "warm", "hide_ui"):
            if key in args:
                shot[key] = args[key]
        result = channel.send("shot", shot, timeout=300.0)
        checked = shotcheck(path)
        if checked:
            result["shotcheck"] = checked
        return result

    if name == "goanna_run":
        return channel.send("run", {"src": args.get("src", "")}, timeout=300.0)

    if name == "goanna_command":
        return channel.send(args.get("cmd", ""), args.get("args") or {}, timeout=300.0)

    raise ChannelError("no such tool '%s'" % name)


# --- MCP over stdio ----------------------------------------------------------

def reply(msg_id, result=None, error=None):
    msg = {"jsonrpc": "2.0", "id": msg_id}
    if error is not None:
        msg["error"] = error
    else:
        msg["result"] = result
    sys.stdout.write(json.dumps(msg) + "\n")
    sys.stdout.flush()


def main():
    channel = Channel()
    session = Session()
    for line in sys.stdin:
        line = line.strip()
        if not line:
            continue
        try:
            msg = json.loads(line)
        except ValueError:
            log("goanna-mcp: ignoring a line that is not JSON")
            continue
        method = msg.get("method")
        msg_id = msg.get("id")
        params = msg.get("params") or {}

        if method == "initialize":
            asked = params.get("protocolVersion")
            reply(msg_id, {
                "protocolVersion": asked if asked in KNOWN_PROTOCOLS else PROTOCOL,
                "capabilities": {"tools": {}},
                "serverInfo": {"name": "goanna", "version": "0.1.0"},
            })
        elif method == "tools/list":
            reply(msg_id, {"tools": TOOLS})
        elif method == "tools/call":
            name = params.get("name", "")
            args = params.get("arguments") or {}
            try:
                result = call_tool(name, args, channel, session)
                text = json.dumps(result, indent=2, default=str)
                reply(msg_id, {"content": [{"type": "text", "text": text}]})
            except ChannelError as exc:
                reply(msg_id, {"content": [{"type": "text", "text": str(exc)}],
                               "isError": True})
            except Exception as exc:                      # noqa: BLE001
                log("goanna-mcp: %s failed: %r" % (name, exc))
                reply(msg_id, {"content": [{"type": "text",
                                            "text": "%s: %s" % (type(exc).__name__, exc)}],
                               "isError": True})
        elif method == "ping":
            reply(msg_id, {})
        elif method == "resources/list":
            reply(msg_id, {"resources": []})
        elif method == "prompts/list":
            reply(msg_id, {"prompts": []})
        elif msg_id is not None:
            reply(msg_id, error={"code": -32601, "message": "no method '%s'" % method})
    return 0


if __name__ == "__main__":
    sys.exit(main())
