# --- the control channel -----------------------------------------------------

class ChannelError(RuntimeError):
    pass


class Channel:
    """One connection per command. The channel runs one command at a time
    anyway, and a short lived connection keeps no state in this process."""

    def __init__(self, host="127.0.0.1", port=None):
        self.host = host
        self.port = int(port or DEFAULT_PORT)

    def up(self):
        try:
            self.send("ping", timeout=5.0)
            return True
        except ChannelError:
            return False

    def send(self, cmd, args=None, timeout=180.0):
        request = json.dumps({"id": 1, "cmd": cmd, "args": args or {}}) + "\n"
        try:
            sock = socket.create_connection((self.host, self.port), timeout=5.0)
        except OSError as exc:
            raise ChannelError(
                "no control channel on %s:%d (%s). Start a client with goanna_session "
                "action=start." % (self.host, self.port, exc))
        with sock:
            sock.settimeout(timeout)
            sock.sendall(request.encode("utf-8"))
            buf = b""
            while b"\n" not in buf:
                try:
                    chunk = sock.recv(65536)
                except socket.timeout:
                    raise ChannelError("the client on port %d did not reply within %gs; it "
                                       "may be still streaming, or wedged" % (self.port, timeout))
                if not chunk:
                    raise ChannelError("the client on port %d closed the connection without "
                                       "replying" % self.port)
                buf += chunk
        reply = json.loads(buf.split(b"\n", 1)[0].decode("utf-8"))
        if not reply.get("ok"):
            raise ChannelError(str(reply.get("error", "the client refused the command")))
        return reply.get("result")


# --- instances ---------------------------------------------------------------

class Instance:
    """One client: a headless one from tools/goanna_headless.py, a windowed
    one this server started, or one somebody else started that was attached
    to by port. `owned` is whether this session may stop it."""

    def __init__(self, ident, kind, control_port=None, owned=False, args=None, proc=None):
        self.id = ident
        self.kind = kind                # goanna, vanilla, window or attached
        self.control_port = control_port
        self.owned = owned
        self.args = dict(args or {})    # what it was started with, for restart
        self.proc = proc                # a windowed client's Popen

    @property
    def channel(self):
        if self.kind == "vanilla":
            raise ChannelError("%s is the vanilla client, which has no control channel; "
                               "goanna_shot and goanna_session stop are what it takes" % self.id)
        return Channel(port=self.control_port)

    def record(self):
        if self.kind in ("goanna", "vanilla"):
            try:
                return gh.load(self.id)
            except gh.LaunchError:
                return None
        return None

    def running(self):
        rec = self.record()
        if rec is not None:
            return rec.get("status") in ("launching", "starting", "running")
        if self.proc is not None:
            return self.proc.poll() is None
        return Channel(port=self.control_port).up()

    def label(self):
        out = {"instance": self.id, "kind": self.kind}
        if self.control_port:
            out["control_port"] = self.control_port
        return out


class Registry:
    def __init__(self):
        self.mine = {}

    def add(self, inst):
        self.mine[inst.id] = inst
        return inst

    def get(self, ident):
        if ident in self.mine:
            return self.mine[ident]
        # A headless instance this server did not start, or started before a
        # restart of this server: the launcher's records say what it is. It
        # counts as ours when the same Claude session started it.
        try:
            rec = gh.load(ident)
        except gh.LaunchError:
            rec = None
        if rec is not None:
            return self.add(Instance(ident, rec.get("kind"), rec.get("control_port"),
                                     owned=rec.get("started_by") == os.getppid(),
                                     args=rec.get("meta")))
        if ident.startswith("attached-") and ident[9:].isdigit():
            return self.add(Instance(ident, "attached", int(ident[9:])))
        raise ChannelError("no instance '%s'. goanna_session action=list shows what is "
                           "running" % ident)

    def pick(self, args, channel=True):
        """The instance a tool call is about: the one named, or the only one
        this session has running, or failing both a client somebody else
        started on the default port."""
        if args.get("instance"):
            return self.get(str(args["instance"]))
        live = [i for i in self.mine.values() if i.running()
                and (not channel or i.kind != "vanilla")]
        if len(live) == 1:
            return live[0]
        if len(live) > 1:
            raise ChannelError("this session has %d clients running (%s); say which with "
                               "instance" % (len(live), ", ".join(i.id for i in live)))
        if channel and Channel(port=DEFAULT_PORT).up():
            return self.add(Instance("attached-%d" % DEFAULT_PORT, "attached", DEFAULT_PORT))
        others = [r["id"] for r in gh.list_records()
                  if r.get("status") == "running" and r.get("id") not in self.mine]
        raise ChannelError("this session has no client running. goanna_session action=start "
                           "launches one headless and returns its instance id%s" % (
                               "; running elsewhere, and usable by instance id: "
                               + ", ".join(others) if others else ""))


# --- starting and stopping ---------------------------------------------------

def diagnose(log_path):
    """Turn an exit into something worth reading."""
    text = gh.tail(log_path, 25)
    if "vkCreateDevice failed" in text or "Unable to create DisplayServer" in text:
        return ("the client could not create a GPU device or a display. On this machine that "
                "has meant the NVIDIA driver needs a reset (journalctl -k shows "
                "NV_ERR_RESET_REQUIRED), which only a reboot clears; software=true renders "
                "on the CPU instead.\n" + text)
    if "Can't open dynamic library" in text or "gdextension" in text.lower():
        return ("the extension did not load; the build output has to land in project/bin/. "
                "Try goanna_session with build=true.\n" + text)
    return text


def build(project):
    """cmake --build build in the checkout the project belongs to, which is
    what a C++ change needs before a relaunch can show it."""
    repo = gh.resolve_project(project).parent
    proc = subprocess.run(["cmake", "--build", "build"], cwd=repo,
                          capture_output=True, text=True, timeout=1800)
    out = (proc.stdout + proc.stderr).strip().split("\n")
    if proc.returncode != 0:
        raise ChannelError("the build in %s failed:\n%s" % (repo, "\n".join(out[-25:])))
    return {"built": str(repo), "tail": out[-3:]}


def start_goanna(reg, args):
    project = args.get("project") or str(REPO)
    if args.get("build"):
        built = build(project)
    else:
        built = None
    control_port = args.get("control_port")
    kw = dict(host=args.get("host", "127.0.0.1"), port=int(args.get("port", 30000)),
              name=args.get("name", "dev"), password=args.get("password", ""))
    env = dict(args.get("env") or {})
    if args.get("headless", True):
        try:
            rec = gh.start_goanna(project, control_port=control_port,
                                  width=int(args.get("width", 1280)),
                                  height=int(args.get("height", 720)),
                                  software=bool(args.get("software", False)), env=env,
                                  label=args.get("label", ""),
                                  meta=dict(args, project=project), **kw)
        except gh.LaunchError as exc:
            raise ChannelError(str(exc))
        inst = reg.add(Instance(rec["id"], "goanna", rec["control_port"], owned=True,
                                args=rec["meta"]))
        out = {"record": gh.describe(rec)}
    else:
        inst = start_window(reg, project, control_port, kw, env, args)
        out = {"pid": inst.proc.pid, "log": inst.args["log"],
               "note": "a window on the desktop: only when the owner asked to watch one"}
    if built:
        out["build"] = built
    ch = inst.channel
    if args.get("wait_ready", True):
        # Connected and holding the definitions, rather than merely running.
        try:
            out["wait"] = ch.send("wait", {"expr": 'client.status()["state"] == "ready"',
                                           "timeout_ms": 180000}, timeout=200.0)
        except ChannelError as exc:
            out["wait"] = "not ready: %s" % exc
        out["status"] = ch.send("status")
    return inst, out


def start_window(reg, project, control_port, kw, env, args):
    """The old way: a window on the desktop. Only for when the owner has
    asked to watch a client; test mode still keeps the pointer free."""
    project = gh.resolve_project(project)
    if control_port is None:
        control_port = gh.free_control_port()
    control_port = int(control_port)
    if not gh.port_free(control_port):
        raise ChannelError("control port %d is already in use" % control_port)
    LOG_DIR.mkdir(parents=True, exist_ok=True)
    log_path = LOG_DIR / ("window-%d-%d.log" % (control_port, int(time.time())))
    run_env = dict(os.environ)
    run_env.update({str(k): str(v) for k, v in env.items()})
    run_env.update({"GOANNA_CONTROL": str(control_port), "GOANNA_NO_POINTER_CAPTURE": "1",
                    "GOANNA_HOST": str(kw["host"]), "GOANNA_PORT": str(kw["port"]),
                    "GOANNA_NAME": str(kw["name"]), "GOANNA_PASS": str(kw["password"])})
    handle = open(log_path, "w")
    proc = subprocess.Popen([gh.find_godot(project), "--path", str(project)], env=run_env,
                            stdout=handle, stderr=subprocess.STDOUT, stdin=subprocess.DEVNULL,
                            start_new_session=True)
    inst = Instance("window-%d" % control_port, "window", control_port, owned=True,
                    args=dict(args, project=str(project), log=str(log_path)), proc=proc)
    deadline = time.time() + 120.0
    while time.time() < deadline:
        if proc.poll() is not None:
            raise ChannelError("the client exited during startup (%d). Its log is %s\n%s"
                               % (proc.returncode, log_path, diagnose(log_path)))
        if Channel(port=control_port).up():
            return reg.add(inst)
        time.sleep(0.5)
    proc.kill()
    raise ChannelError("the channel never opened. The log is %s\n%s"
                       % (log_path, diagnose(log_path)))


def stop_instance(inst, force=False):
    if not inst.owned and not force:
        raise ChannelError("%s was not started by this session, so it is left alone. Whoever "
                           "started it stops it; force=true takes it over deliberately."
                           % inst.id)
    if inst.kind in ("goanna", "vanilla"):
        try:
            return gh.stop(inst.id)
        except gh.LaunchError as exc:
            raise ChannelError(str(exc))
    out = {"stopped": False}
    ch = Channel(port=inst.control_port)
    if ch.up():
        ch.send("quit", timeout=30.0)
        out["stopped"] = True
        deadline = time.time() + 15.0
        while time.time() < deadline and ch.up():
            time.sleep(0.5)
    if inst.proc is not None and inst.proc.poll() is None:
        # Only the process this server started, by its own handle.
        inst.proc.terminate()
        try:
            inst.proc.wait(timeout=10)
        except subprocess.TimeoutExpired:
            inst.proc.kill()
            inst.proc.wait(timeout=5)
        out["stopped"] = True
    return out


