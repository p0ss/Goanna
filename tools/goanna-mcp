LOG_DIR = pathlib.Path(os.environ.get("GOANNA_MCP_LOG_DIR",
                                      pathlib.Path(tempfile.gettempdir()) / "goanna-mcp"))


def log(*parts):
    print(*parts, file=sys.stderr, flush=True)


# --- the control channel -----------------------------------------------------

class ChannelError(RuntimeError):
    pass


class Channel:
    """One connection per command. The channel runs one command at a time
    anyway, and a short lived connection keeps no state in this process."""

    def __init__(self, host="127.0.0.1", port=None):
        self.host = host
        self.port = int(port or os.environ.get("GOANNA_CONTROL_PORT", 30800))

    def up(self):
        try:
            self.send("ping", timeout=5.0)
            return True
        except ChannelError:
            return False

    def send(self, cmd, args=None, timeout=180.0):
        request = json.dumps({"id": 1, "cmd": cmd, "args": args or {}}) + "\n"
        try:
            sock = socket.create_connection((self.host, self.port), timeout=5.0)
        except OSError as exc:
            raise ChannelError(
                "no control channel on %s:%d (%s). Start one with goanna_session "
                "action=start, or launch the client yourself with GOANNA_CONTROL=1."
                % (self.host, self.port, exc))
        with sock:
            sock.settimeout(timeout)
            sock.sendall(request.encode("utf-8"))
            buf = b""
            while b"\n" not in buf:
                try:
                    chunk = sock.recv(65536)
                except socket.timeout:
                    raise ChannelError("the client did not reply within %gs; it may be "
                                       "still streaming, or wedged" % timeout)
                if not chunk:
                    raise ChannelError("the client closed the connection without replying")
                buf += chunk
        reply = json.loads(buf.split(b"\n", 1)[0].decode("utf-8"))
        if not reply.get("ok"):
            raise ChannelError(str(reply.get("error", "the client refused the command")))
        return reply.get("result")


# --- the client process ------------------------------------------------------

class Session:
    """Start, stop and rebuild the client. Held across calls, so a restart
    can reuse whatever the last start was given."""

    def __init__(self):
        self.proc = None
        self.log_path = None
        self.args = {"host": "127.0.0.1", "port": 30000, "name": "dev",
                     "password": "", "env": {}}

    @staticmethod
    def godot():
        candidates = [os.environ.get("GODOT_BIN"), "godot", "godot4",
                      str(REPO.parent / "Godot_v4.5.1-stable_linux.x86_64")]
        for cand in candidates:
            if not cand:
                continue
            found = shutil.which(cand) or (cand if os.access(cand, os.X_OK) else None)
            if found:
                return found
        raise ChannelError("no Godot binary found; set GODOT_BIN")

    @staticmethod
    def diagnose(log_path):
        """Turn an exit code into something worth reading. A client that
        cannot open a display fails this way whenever the host trims the
        environment it starts this server with, which is not obvious from
        the exit code alone."""
        try:
            tail = pathlib.Path(log_path).read_text(errors="replace").strip().split("\n")[-20:]
        except OSError:
            return "the log could not be read"
        text = "\n".join(tail)
        if "Unable to create DisplayServer" in text or "X11 Display is not available" in text:
            return ("the client could not open a display. Whatever started this MCP server "
                    "did not pass DISPLAY, WAYLAND_DISPLAY and XDG_RUNTIME_DIR through; pass "
                    "them in env, or start the client yourself with GOANNA_CONTROL=1. A shot "
                    "needs a real display, so headless is not a way around it.\n" + text)
        if "Can't open dynamic library" in text or "gdextension" in text.lower():
            return ("the extension did not load; the build output has to land in "
                    "project/bin/. Try goanna_session with build=true.\n" + text)
        return text

    def build(self):
        """cmake --build build, which is what a C++ change needs before a
        relaunch can show it."""
        proc = subprocess.run(["cmake", "--build", "build"], cwd=REPO,
                              capture_output=True, text=True, timeout=1800)
        out = (proc.stdout + proc.stderr).strip().split("\n")
        if proc.returncode != 0:
            raise ChannelError("the build failed:\n" + "\n".join(out[-25:]))
        return {"built": True, "tail": out[-3:]}

    def start(self, channel, host=None, port=None, name=None, password=None, env=None,
              wait_ready=True):
        if channel.up():
            raise ChannelError("a client is already answering on port %d; stop it first "
                               "or use action=restart" % channel.port)
        for key, value in (("host", host), ("port", port), ("name", name),
                           ("password", password)):
            if value is not None:
                self.args[key] = value
        if env:
            self.args["env"] = dict(env)
        LOG_DIR.mkdir(parents=True, exist_ok=True)
        self.log_path = LOG_DIR / ("client-%d.log" % int(time.time()))
        run_env = dict(os.environ)
        run_env.update({k: str(v) for k, v in self.args["env"].items()})
        run_env.update({
            "GOANNA_CONTROL": str(channel.port),
            "GOANNA_HOST": str(self.args["host"]),
            "GOANNA_PORT": str(self.args["port"]),
            "GOANNA_NAME": str(self.args["name"]),
            "GOANNA_PASS": str(self.args["password"]),
        })
        handle = open(self.log_path, "w")
        self.proc = subprocess.Popen([self.godot(), "--path", "project"], cwd=REPO,
                                     env=run_env, stdout=handle, stderr=subprocess.STDOUT,
                                     stdin=subprocess.DEVNULL, start_new_session=True)
        deadline = time.time() + 120.0
        while time.time() < deadline:
            if self.proc.poll() is not None:
                raise ChannelError("the client exited during startup (%d). Its log is %s\n%s"
                                   % (self.proc.returncode, self.log_path,
                                      self.diagnose(self.log_path)))
            if channel.up():
                break
            time.sleep(0.5)
        else:
            raise ChannelError("the channel never opened. The log is %s\n%s"
                               % (self.log_path, self.diagnose(self.log_path)))
        out = {"pid": self.proc.pid, "log": str(self.log_path), "args": dict(self.args)}
        if wait_ready:
            # Connected and holding the definitions, rather than merely running.
            out["wait"] = channel.send("wait", {
                "expr": 'client.status()["state"] == "ready"', "timeout_ms": 180000})
            out.update(channel.send("status"))
        return out

    def reap(self):
        """Collect the child if it has exited on its own.

        Only stop() ever polled the handle, so a client that quit by itself,
        crashed, was told to quit over the control channel by something else,
        or was killed, stayed a zombie for the life of this server: exited,
        but never waited on. Two of them had been sitting in the process table
        for hours. That is not merely untidy. Anything that asks whether the
        client is running by looking for the process gets told yes, so a dead
        client reads as a live one that has stopped answering, which is what
        a frozen client looks like too. Hours went into that confusion today.
        Poll wherever liveness is reported, and the kernel lets the entry go.
        """
        if self.proc is not None and self.proc.poll() is not None:
            self.proc = None

    def stop(self, channel):
        stopped = False
        if channel.up():
            channel.send("quit", timeout=30.0)
            stopped = True
            deadline = time.time() + 15.0
            while time.time() < deadline and channel.up():
                time.sleep(0.5)
        if self.proc is not None and self.proc.poll() is None:
            self.proc.terminate()
            try:
                self.proc.wait(timeout=10)
            except subprocess.TimeoutExpired:
                self.proc.kill()
            stopped = True
        self.proc = None
        return {"stopped": stopped}


