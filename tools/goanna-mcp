def shotcheck(path):
    script = REPO / "tools" / "shotcheck.py"
    if not script.exists():
        return None
    try:
        proc = subprocess.run([sys.executable, str(script), path],
                              capture_output=True, text=True, timeout=60)
    except (OSError, subprocess.TimeoutExpired):
        return None
    text = (proc.stdout or proc.stderr).strip()
    return text or None


UI_ACTIONS = {"tree": "ui_tree", "click": "ui_click", "hover": "ui_hover", "type": "ui_type",
              "scroll": "ui_scroll", "key": "key"}
UI_KEYS = ("name", "tab", "slot", "item", "text", "nth", "max_ms", "x", "y", "button", "double",
           "shift", "ctrl", "alt", "ms", "amount", "clear", "enter", "key", "hold_ms",
           "hidden", "labels")


def session_tool(args, reg):
    action = args.get("action", "status")
    if action == "list":
        out = []
        for rec in gh.list_records():
            if args.get("all") or rec.get("status") in ("launching", "starting", "running"):
                row = gh.describe(rec)
                row["this_session"] = rec.get("started_by") == os.getppid()
                out.append(row)
        for inst in reg.mine.values():
            if inst.kind in ("window", "attached") and inst.running():
                out.append(dict(inst.label(), this_session=inst.owned))
        return None, {"instances": out}
    if action == "start":
        inst, out = start_goanna(reg, args)
        return inst, out
    if action == "start_vanilla":
        try:
            rec = gh.start_vanilla(host=args.get("host", "127.0.0.1"),
                                   port=int(args.get("port", 30000)),
                                   name=args.get("name", "vanilla"),
                                   password=args.get("password", ""),
                                   width=int(args.get("width", 1280)),
                                   height=int(args.get("height", 720)),
                                   software=bool(args.get("software", False)),
                                   settings=args.get("settings"), meta=dict(args))
        except gh.LaunchError as exc:
            raise ChannelError(str(exc))
        inst = reg.add(Instance(rec["id"], "vanilla", owned=True, args=rec["meta"]))
        return inst, {"record": gh.describe(rec),
                      "note": "loading takes a while, much longer with software=true; "
                              "goanna_shot with wait_ms, or read client_log"}
    if action == "attach":
        port = int(args.get("control_port", DEFAULT_PORT))
        if not Channel(port=port).up():
            raise ChannelError("nothing answers on control port %d" % port)
        inst = reg.add(Instance("attached-%d" % port, "attached", port))
        return inst, {"attached": True, "status": inst.channel.send("status")}
    if action == "stop":
        inst = reg.pick(args, channel=False)
        return inst, stop_instance(inst, force=bool(args.get("force")))
    if action == "restart":
        inst = reg.pick(args, channel=False)
        if inst.kind not in ("goanna", "window"):
            raise ChannelError("only a Goanna client this session started can be restarted")
        again = dict(inst.args)
        for key in ("build", "env", "project", "name", "host", "port", "label", "software"):
            if key in args:
                again[key] = args[key]
        again["control_port"] = inst.control_port
        again["headless"] = inst.kind == "goanna"
        stopped = stop_instance(inst, force=bool(args.get("force")))
        reg.mine.pop(inst.id, None)
        deadline = time.time() + 20.0
        while time.time() < deadline and not gh.port_free(inst.control_port):
            time.sleep(0.5)
        new, out = start_goanna(reg, again)
        out["stopped"] = stopped
        return new, out
    if action == "status":
        inst = reg.pick(args, channel=False)
        out = {"running": inst.running(), "this_session": inst.owned}
        rec = inst.record()
        if rec is not None:
            out["record"] = gh.describe(rec)
        if inst.kind != "vanilla" and out["running"]:
            try:
                out["status"] = inst.channel.send("status")
            except ChannelError as exc:
                # A client that exited and one that is wedged both fail to
                # answer, and they want opposite responses.
                out["status"] = ("the process is alive but not answering on its control "
                                 "channel: wedged rather than gone (%s). Look at it before "
                                 "restarting; the overlay says what it was last asked." % exc)
        return inst, out
    raise ChannelError("unknown action '%s'" % action)


def call_tool(name, args, reg):
    """Returns (instance or None, result)."""
    if name == "goanna_session":
        return session_tool(args, reg)

    if name == "goanna_shot":
        inst = reg.pick(args, channel=False)
        path = args.get("path")
        if not path:
            LOG_DIR.mkdir(parents=True, exist_ok=True)
            path = str(LOG_DIR / ("shot-%s-%d.png" % (inst.id, int(time.time() * 1000))))
        if inst.kind == "vanilla" or args.get("method") in ("gamescope", "x11"):
            if inst.kind not in ("goanna", "vanilla"):
                raise ChannelError("method=%s needs a headless instance" % args.get("method"))
            time.sleep(max(0, int(args.get("wait_ms", 0))) / 1000.0)
            try:
                result = gh.screenshot(inst.id, path, method=args.get("method", "auto"))
            except gh.LaunchError as exc:
                raise ChannelError(str(exc))
        else:
            shot = {"path": path}
            for key in ("settle", "warm", "hide_ui"):
                if key in args:
                    shot[key] = args[key]
            result = inst.channel.send("shot", shot, timeout=600.0)
        checked = shotcheck(path)
        if checked:
            result["shotcheck"] = checked
        return inst, result

    inst = reg.pick(args)
    ch = inst.channel

    if name == "goanna_status":
        return inst, dict(ch.send("status"), deviations=ch.send("deviations"))

    if name == "goanna_inspect":
        request = {"target": args.get("target", "capabilities")}
        if "position" in args:
            position = vec(args["position"], "position")
            request["pos"] = [position["x"], position["y"], position["z"]]
        for key in ("depth", "limit", "texture"):
            if key in args:
                request[key] = args[key]
        return inst, ch.send("inspect", request)

    if name == "goanna_view":
        out = {}
        if "teleport" in args:
            out["teleport"] = ch.send("tp", vec(args["teleport"], "teleport"))
        pose = {}
        if "position" in args:
            pose.update(vec(args["position"], "position"))
        for key in ("pitch", "yaw", "fly"):
            if key in args:
                pose[key] = args[key]
        if pose:
            out["pose"] = ch.send("pose", pose)
        if "look_at" in args:
            out["look"] = ch.send("look", vec(args["look_at"], "look_at"))
        if not out:
            raise ChannelError("goanna_view wants teleport, position, look_at, pitch, yaw or fly")
        return inst, out

    if name == "goanna_world":
        out = {}
        if "time" in args:
            out["time"] = ch.send("time", {"tod": args["time"],
                                           "server": bool(args.get("time_on_server"))})
        if "weather" in args:
            out["weather"] = ch.send("weather", {"kind": args["weather"],
                                                 "fake": bool(args.get("fake_weather"))})
        if "give" in args:
            out["give"] = ch.send("give", {"item": args["give"],
                                           "count": int(args.get("count", 1))})
        if "spawn" in args:
            spawn = {"name": args["spawn"], "count": int(args.get("count", 1))}
            if "at" in args:
                spawn.update(vec(args["at"], "at"))
            out["spawn"] = ch.send("spawn", spawn)
        if "chat" in args:
            out["chat"] = ch.send("chat", {"text": args["chat"]})
        if not out:
            raise ChannelError("goanna_world wants time, weather, give, spawn or chat")
        return inst, out

    if name == "goanna_settings":
        action = args.get("action")
        if action == "list":
            return inst, ch.send("settings")
        if action == "get":
            return inst, ch.send("get", {"key": args.get("key", "")})
        if action == "set":
            if "value" not in args:
                raise ChannelError("set wants a value")
            return inst, ch.send("set", {"key": args.get("key", ""), "value": args["value"]})
        raise ChannelError("goanna_settings wants action get, set or list")

    if name == "goanna_ui":
        action = args.get("action", "tree")
        if action not in UI_ACTIONS:
            raise ChannelError("goanna_ui action is one of %s" % ", ".join(UI_ACTIONS))
        request = {k: args[k] for k in UI_KEYS if k in args}
        if "key_action" in args:
            request["action"] = args["key_action"]
        return inst, ch.send(UI_ACTIONS[action], request, timeout=300.0)

    if name == "goanna_run":
        return inst, ch.send("run", {"src": args.get("src", "")}, timeout=300.0)

    if name == "goanna_command":
        return inst, ch.send(args.get("cmd", ""), args.get("args") or {}, timeout=300.0)

    raise ChannelError("no such tool '%s'" % name)


# --- MCP over stdio ----------------------------------------------------------

def reply(msg_id, result=None, error=None):
    msg = {"jsonrpc": "2.0", "id": msg_id}
    if error is not None:
        msg["error"] = error
    else:
        msg["result"] = result
    sys.stdout.write(json.dumps(msg) + "\n")
    sys.stdout.flush()


def main():
    reg = Registry()
    for line in sys.stdin:
        line = line.strip()
        if not line:
            continue
        try:
            msg = json.loads(line)
        except ValueError:
            log("goanna-mcp: ignoring a line that is not JSON")
            continue
        method = msg.get("method")
        msg_id = msg.get("id")
        params = msg.get("params") or {}

        if method == "initialize":
            asked = params.get("protocolVersion")
            reply(msg_id, {
                "protocolVersion": asked if asked in KNOWN_PROTOCOLS else PROTOCOL,
                "capabilities": {"tools": {}},
                "serverInfo": {"name": "goanna", "version": "0.2.0"},
            })
        elif method == "tools/list":
            reply(msg_id, {"tools": TOOLS})
        elif method == "tools/call":
            name = params.get("name", "")
            args = params.get("arguments") or {}
            try:
                inst, result = call_tool(name, args, reg)
                # Every reply says which client it came from: two sessions
                # driving each other's clients through a shared port went
                # unnoticed for a whole evening.
                body = dict(inst.label(), result=result) if inst is not None \
                    else {"result": result}
                text = json.dumps(body, indent=2, default=str)
                reply(msg_id, {"content": [{"type": "text", "text": text}]})
            except ChannelError as exc:
                reply(msg_id, {"content": [{"type": "text", "text": str(exc)}],
                               "isError": True})
            except Exception as exc:                      # noqa: BLE001
                log("goanna-mcp: %s failed: %r" % (name, exc))
                reply(msg_id, {"content": [{"type": "text",
                                            "text": "%s: %s" % (type(exc).__name__, exc)}],
                               "isError": True})
        elif method == "ping":
            reply(msg_id, {})
        elif method == "resources/list":
            reply(msg_id, {"resources": []})
        elif method == "prompts/list":
            reply(msg_id, {"prompts": []})
        elif msg_id is not None:
            reply(msg_id, error={"code": -32601, "message": "no method '%s'" % method})
    return 0


if __name__ == "__main__":
    sys.exit(main())
