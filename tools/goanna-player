#!/usr/bin/env python3
"""Query Goanna's experimental read-only player-agent endpoint."""
import argparse
import json
import socket
import sys

def main():
    parser = argparse.ArgumentParser(description=__doc__)
    parser.add_argument("command", choices=("hello", "observe"))
    parser.add_argument("--host", default="127.0.0.1")
    parser.add_argument("--port", type=int, default=30850)
    parser.add_argument("--since-event", type=int, default=0)
    args = parser.parse_args()
    request = {"id": 1, "cmd": args.command, "args": {}}
    if args.command == "observe":
        request["args"]["since_event"] = args.since_event
    try:
        with socket.create_connection((args.host, args.port), timeout=5) as peer:
            peer.sendall((json.dumps(request) + "\n").encode())
            data = b""
            while b"\n" not in data:
                chunk = peer.recv(65536)
                if not chunk:
                    raise RuntimeError("endpoint closed without replying")
                data += chunk
    except (OSError, RuntimeError) as error:
        sys.exit(str(error))
    reply = json.loads(data.split(b"\n", 1)[0])
    if not reply.get("ok"):
        sys.exit(reply.get("error", "request failed"))
    print(json.dumps(reply["result"], indent=2))

if __name__ == "__main__":
    main()
