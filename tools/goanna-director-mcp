                            "lines": {"type": "array", "items": S},
                            "enchantments": {"type": "array", "items": {
                                "type": "object", "properties": {"name": S, "level": N}}},
                            "delivery": {"type": "string", "enum": ["drop", "container", "npc"]},
                            "npc": NPC, "reason": REASON}, ["near", "item", "reason"])},
    {"name": "director_place_structure",
     "description": "Put a building in the world at once, if this world allows structures (see "
                    "director_status): a game structure by name (catalogue kind structure; "
                    "those with loot: true come with the game's loot), or one you author as "
                    "palette and layers. at is the point it stands on, the centre of its "
                    "footprint; or near a player within distance. Refused on protected ground, "
                    "where players have dug or built, on anyone standing there, near spawn. "
                    "Costs nodes from the hourly build budget. Undo puts the ground back, "
                    "keeping anything players changed since.",
     "inputSchema": schema({"structure": S, "palette": PALETTE, "layers": LAYERS,
                            "at": POINT, "near": NEAR, "distance": DISTANCE, "reason": REASON},
                           ["reason"])},
    {"name": "director_undo",
     "description": "Reverse one of your acts by its id (a1, a2, ...): an encounter's remaining "
                    "creatures removed, a character removed or unnamed, an order stopped, a "
                    "fact forgotten, an untaken reward taken back, a building taken down. "
                    "Speech cannot be unsaid.",
     "inputSchema": schema({"id": S, "reason": REASON}, ["id"])},
    {"name": "director_stop",
     "description": "Stop the director: every creature it placed is removed, every queued "
                    "intent cancelled, and everything refused until the operator types "
                    "/director start in game.",
     "inputSchema": schema({"reason": REASON}, ["reason"])},
]

# Which tools each role sees. A role's agent is offered only its own tools,
# so its choice stays small however much the director grows. The server mod
# still checks every act; this is the menu, not the authority.
ROLES = {
    "gm": None,
    "voice": {"director_status", "director_events", "director_player", "director_memory",
              "director_speak", "director_remember"},
    "watcher": {"director_status", "director_events", "director_player", "director_catalogue",
                "director_memory"},
}


# A ruleset's tools by role: the game master gets them all, a watcher only
# a ruleset's queries, a voice none.
RULESET_KINDS = {"gm": {"act", "query"}, "voice": set(), "watcher": {"query"}}
TOOL_NAME = re.compile(r"^[a-z][a-z0-9_]{0,63}$")
FIXED_NAMES = {t["name"] for t in TOOLS}


def plain_schema(value):
    """A ruleset's schema as JSON Schema. Luanti writes an empty Lua table as
    null, so empty properties, required and enum lists come back here as
    null and are restored."""
    if isinstance(value, list):
        return [plain_schema(v) for v in value]
    if not isinstance(value, dict):
        return value
    out = {}
    for key, v in value.items():
        if key == "properties":
            v = {k: plain_schema(p) for k, p in (v or {}).items()} if isinstance(v, dict) else {}
        elif key in ("required", "enum"):
            v = list(v) if isinstance(v, list) else []
        else:
            v = plain_schema(v)
        out[key] = v
    if out.get("type") == "object":
        out.setdefault("properties", {})
    if "required" in out and not out["required"]:
        del out["required"]
    return out


def ruleset_tools(hello):
    """One tool per ruleset intent and query in the hello, named
    <ruleset>_<name>, with the ruleset's own description and schema. The
    server mod checks every argument against the same schema again."""
    rulesets = ((hello or {}).get("capabilities") or {}).get("rulesets")
    out = {}
    if not isinstance(rulesets, dict):
        return out
    for rs_name in sorted(rulesets):
        rs = rulesets[rs_name] if isinstance(rulesets[rs_name], dict) else {}
        for kind, key in (("act", "intents"), ("query", "queries")):
            entries = rs.get(key)
            if not isinstance(entries, dict):
                continue
            for name in sorted(entries):
                e = entries[name] if isinstance(entries[name], dict) else {}
                tool = "%s_%s" % (rs_name, name)
                if not TOOL_NAME.match(tool) or tool in FIXED_NAMES or tool in out:
                    log("ruleset tool %r skipped: its name is not usable" % tool)
                    continue
                schema = plain_schema(e.get("schema") or {})
                schema["type"] = "object"
                schema.setdefault("properties", {})
                desc = (e.get("description") or "").strip()
                if kind == "act":
                    schema["properties"]["reason"] = REASON
                    schema["required"] = sorted(set(schema.get("required") or []) | {"reason"})
                    desc = ("%s The %s ruleset decides; a refusal names its reason (rules "
                            "with the ruleset's own rule)." % (desc, rs_name)).strip()
                    if e.get("paced"):
                        desc += (" Paced: waits for the build up of every player it concerns "
                                 "(when: now refuses instead).")
                    if e.get("undoable"):
                        desc += " director_undo can reverse it."
                else:
                    desc = ("%s A question to the %s ruleset; changes nothing."
                            % (desc, rs_name)).strip()
                out[tool] = {"kind": kind, "type": name, "ruleset": rs_name,
                             "follow_up": e.get("follow_up"),
                             "tool": {"name": tool, "description": desc, "inputSchema": schema}}
    return out


def tools_for(role, director=None):
    allowed = ROLES[role]
    fixed = [t for t in TOOLS if allowed is None or t["name"] in allowed]
    kinds = RULESET_KINDS[role]
    generated = (director.generated if director else {}) or {}
    return fixed + [g["tool"] for _, g in sorted(generated.items()) if g["kind"] in kinds]


# tool -> (intent, {tool argument: intent argument}, fixed intent arguments)
ACTS = {
    "director_stage_encounter": ("stage_encounter", {k: k for k in [
        "near", "budget", "theme", "mobs", "when", "distance", "hidden", "leash_s",
        "valid_for_s"]}, {}),
    "director_cast_npc": ("cast_npc", {k: k for k in [
        "near", "name", "mob", "guid", "hold", "armed", "distance"]}, {}),
    "director_move": ("order", {"npc": "npc", "goal": "order", "target": "target", "at": "at",
                                "points": "points", "range": "distance",
                                "pause_s": "pause_s"}, {}),
    "director_attack": ("order", {"npc": "npc", "target": "target", "leash_s": "leash_s"},
                        {"order": "attack"}),
    "director_build": ("order", {k: k for k in [
        "npc", "structure", "palette", "layers", "at", "near", "distance"]}, {"order": "build"}),
    "director_interact": ("order", {"npc": "npc", "action": "order", "item": "item",
                                    "player": "target", "profession": "profession"}, {}),
    "director_grant_reward": ("grant_reward", {k: k for k in [
        "near", "item", "count", "name", "lines", "enchantments", "delivery", "npc"]}, {}),
    "director_place_structure": ("place_structure", {k: k for k in [
        "structure", "palette", "layers", "at", "near", "distance"]}, {}),
    "director_speak": ("speak", {"as": "as", "to": "to", "text": "text"}, {}),
    "director_remember": ("remember", {k: k for k in ["npc", "player", "fact",
                                                       "disposition"]}, {}),
    "director_undo": ("undo", {"id": "id"}, {}),
    "director_stop": ("stop", {}, {}),
}

# Goals that run until something ends them, rather than finishing.
STANDING_GOALS = {"hold", "watch", "stay", "patrol", "follow"}


def follow_up(name, args, body):
    """What an accepted or queued act's outcome will arrive as, so the model
    knows to watch director_events for it rather than guess."""
    status, act = body.get("status"), body.get("id")
    if status not in ("accepted", "queued"):
        return None
    if name == "director_stage_encounter":
        if status == "queued":
            return {"event": "encounter_started", "act": act,
                    "then": "encounter_ended when it is over"}
        return {"event": "encounter_ended", "act": act}
    if name == "director_place_structure":
        return {"event": "structure_placed or structure_failed", "act": act}
    if name == "director_move" and args.get("goal") in STANDING_GOALS:
        return {"event": "npc_order", "act": act,
                "when": "only if the goal fails or is replaced; it holds until then"}
    if name in ("director_move", "director_attack", "director_build", "director_grant_reward"):
        return {"event": "npc_order", "act": act}
    return None


def brief(director):
    """The short status: what is on in this world and what is left."""
    caps = (director.hello or {}).get("capabilities") or {}
    out = {"connected": director.connected(), "session": director.known_session,
           "game": caps.get("game")}
    if not director.connected():
        return out
    s = director.request("query", "status", {}).get("body") or {}
    b = s.get("budgets") or {}
    adapters = caps.get("adapters") or {}
    out.update({
        "stopped": s.get("stopped"),
        "features": {
            "encounters_and_characters": adapters.get("mobs", "none") != "none",
            "rewards": True,
            "enchantments": adapters.get("items", "none") != "none",
            "structures": bool(b.get("structures")),
            "game_structures": adapters.get("structures", "none") != "none",
        },
        "left": {"encounter_points": b.get("points_left"),
                 "reward_points": b.get("reward_points_left"),
                 "largest_reward": b.get("reward_max"),
                 "build_nodes": b.get("build_nodes_left"),
                 "creatures": "%s of %s live" % (b.get("live_entities"), b.get("max_entities"))},
        "players": s.get("pacing"),
        "npcs": [{"name": n.get("name"), "order": n.get("order"), "built": n.get("built")}
                 for n in s.get("npcs") or []],
        "encounters_live": len(s.get("encounters") or []),
        "queued": len(s.get("queued") or []),
        "catalogue": s.get("catalogue"),
        "rulesets": {name: (rs or {}).get("description")
                     for name, rs in ((caps.get("rulesets") or {}) if isinstance(
                         caps.get("rulesets"), dict) else {}).items()},
        "events_waiting": sum(1 for e in director.events
                              if int(e.get("seq", 0)) > director.model_seq),
    })
    return out


def call_tool(director, name, args, role="gm"):
    allowed = ROLES[role]
    gen = director.generated.get(name)
    if gen is not None:
        if gen["kind"] not in RULESET_KINDS[role]:
            raise ToolError("'%s' is not a tool of the %s role" % (name, role))
        if gen["kind"] == "query":
            body = director.request("query", gen["type"], args)
            if body.get("status") != "ok":
                return body
            return body.get("body")
        payload = {k: v for k, v in args.items() if k != "reason"}
        body = director.request("act", gen["type"], payload, reason=args.get("reason"))
        if isinstance(body, dict) and gen.get("follow_up") and \
                body.get("status") in ("accepted", "queued"):
            body = dict(body, follow_up={"event": gen["follow_up"], "act": body.get("id")})
        return body
    if allowed is not None and name not in allowed:
        raise ToolError("'%s' is not a tool of the %s role" % (name, role))
    if name == "director_status":
        if not args.get("detail"):
            return brief(director)
        out = {"connected": director.connected(), "session": director.known_session,
               "capabilities": (director.hello or {}).get("capabilities"),
               "events_buffered": len(director.events), "last_seq": director.last_seq}
        if director.connected():
            out["server"] = director.request("query", "status", {}).get("body")
        return out
    if name == "director_events":
        return director.take_events(args.get("after"), float(args.get("wait_s", 0)),
                                    max(1, min(int(args.get("limit", 200)), 1000)))
    if name == "director_player":
        who = args.get("player") or args.get("name") or ""
        return director.request("query", "player", {"name": who}).get("body")
    if name == "director_catalogue":
        return director.catalogue(args)
    if name == "director_memory":
        q = {"npc": args.get("npc", "")}
        if args.get("player"):
            q["player"] = args["player"]
        return director.request("query", "memory", q).get("body")
    if name in ACTS:
        mtype, mapping, fixed = ACTS[name]
        payload = dict(fixed)
        for key, to in mapping.items():
            if key in args:
                payload[to] = args[key]
        body = director.request("act", mtype, payload, reason=args.get("reason"))
        nxt = follow_up(name, args, body) if isinstance(body, dict) else None
        if nxt:
            body = dict(body, follow_up=nxt)
        return body
    raise ToolError("no such tool '%s'" % name)


GM_INSTRUCTIONS = """You are the game master of a Luanti world. The game decides: every act
you take is checked against the operator's budgets, the players' opt outs and pacing, and
the world, and a refusal names its reason and usually the fix.

Start with director_status for the brief: what is on in this world and what is left. Use
director_catalogue to find items, creatures and structures by search; do not guess names.
Read director_events before you act, and again after: an accepted act carries follow_up,
naming the event its outcome will arrive as. Every act needs a reason, and returns an id
director_undo can reverse.

Words mean the same in every tool: npc is the character who acts, player is whom it
concerns, target is whom an act is aimed at, at is a point [x, y, z], and near with
distance means find a place near that player.

Tools named <ruleset>_<name> belong to the game's own rulesets, listed in the brief: they
follow that game's rules, which say more than the director's own tools can. The list can
grow when a server connects; it is announced when it does."""

INSTRUCTIONS = {
    "gm": GM_INSTRUCTIONS,
    "voice": """You speak for characters in a Luanti world that a game master has cast.
Read director_events for lines players address to your characters (npc_addressed, with what
the character remembers of the player), answer with director_speak as that character, and
keep what matters with director_remember. Lines are short, rate limited and always shown as
the character's. You cannot move characters or change the world; the game master does.""",
    "watcher": """You watch a Luanti world for a game master and change nothing. Read
director_status for the brief, director_events for what happens, director_player for one
player, and director_catalogue to name what you see.""",
}


STDOUT = threading.Lock()


def write_message(msg):
    with STDOUT:
        sys.stdout.write(json.dumps(msg) + "\n")
        sys.stdout.flush()


def reply(msg_id, result=None, error=None):
    msg = {"jsonrpc": "2.0", "id": msg_id}
    if error is not None:
        msg["error"] = error
    else:
        msg["result"] = result
    write_message(msg)


def parse_args(argv):
    world = os.environ.get("GOANNA_DIRECTOR_WORLD", "")
    port = None
    role = "gm"
    i = 1
    while i < len(argv):
        if argv[i] == "--world" and i + 1 < len(argv):
            world = argv[i + 1]
            i += 2
        elif argv[i] == "--port" and i + 1 < len(argv):
            port = int(argv[i + 1])
            i += 2
        elif argv[i] == "--role" and i + 1 < len(argv):
            role = argv[i + 1]
            i += 2
        else:
            log("unknown argument", argv[i])
            i += 1
    if role not in ROLES:
        log("unknown role %r; the roles are %s" % (role, ", ".join(sorted(ROLES))))
        sys.exit(2)
    return world, port, role


def main(argv):
    world, port_override, role = parse_args(argv)
    conf = os.path.join(os.path.expanduser(world), "goanna_director.conf") if world else ""
    director = Director(conf, port_override)
    port = director.reload()
    # Both transports are ready; the server's goanna_director_transport
    # decides which it uses. Files need only the world folder.
    if world:
        director.link = FileLink(director, world)
    # A ruleset's tools appear with the server's hello, after the MCP client
    # has listed the tools, so the client is told to list them again.
    initialised = threading.Event()

    def tools_changed():
        if initialised.is_set():
            write_message({"jsonrpc": "2.0", "method": "notifications/tools/list_changed"})
    director.on_tools_changed = tools_changed
    server = None
    try:
        server = http.server.ThreadingHTTPServer(("127.0.0.1", port), make_handler(director))
        server.daemon_threads = True
        threading.Thread(target=server.serve_forever, daemon=True).start()
        log("listening on 127.0.0.1:%d for %s" % (port, conf or "(no world given)"))
    except OSError as exc:
        # Another world's service may hold the port; the file transport
        # does not need it.
        log("no HTTP endpoint on port %d (%s); files only" % (port, exc))

    for line in sys.stdin:
        line = line.strip()
        if not line:
            continue
        try:
            msg = json.loads(line)
        except ValueError:
            log("ignoring a line that is not JSON")
            continue
        method = msg.get("method")
        msg_id = msg.get("id")
        params = msg.get("params") or {}
        if method == "initialize":
            asked = params.get("protocolVersion")
            reply(msg_id, {
                "protocolVersion": asked if asked in KNOWN_PROTOCOLS else PROTOCOL,
                "capabilities": {"tools": {"listChanged": True}},
                "serverInfo": {"name": "goanna-director", "version": "0.2.0"},
                "instructions": INSTRUCTIONS[role],
            })
        elif method == "notifications/initialized":
            initialised.set()
        elif method == "tools/list":
            initialised.set()
            reply(msg_id, {"tools": tools_for(role, director)})
        elif method == "tools/call":
            name = params.get("name", "")
            args = params.get("arguments") or {}
            try:
                result = call_tool(director, name, args, role)
                reply(msg_id, {"content": [{"type": "text",
                                            "text": json.dumps(result, indent=2, default=str)}]})
            except ToolError as exc:
                reply(msg_id, {"content": [{"type": "text", "text": str(exc)}], "isError": True})
            except Exception as exc:                      # noqa: BLE001
                log("%s failed: %r" % (name, exc))
                reply(msg_id, {"content": [{"type": "text",
                                            "text": "%s: %s" % (type(exc).__name__, exc)}],
                               "isError": True})
        elif method == "ping":
            reply(msg_id, {})
        elif method == "resources/list":
            reply(msg_id, {"resources": []})
        elif method == "prompts/list":
            reply(msg_id, {"prompts": []})
        elif msg_id is not None:
            reply(msg_id, error={"code": -32601, "message": "no method '%s'" % method})
    if server:
        server.shutdown()
    return 0


if __name__ == "__main__":
    if sys.argv[1:2] in (["-h"], ["--help"]):
        print(__doc__)
        sys.exit(0)
    sys.exit(main(sys.argv))
