def call_tool(director, name, args):
    if name == "director_status":
        out = {"connected": director.connected(), "session": director.known_session,
               "capabilities": (director.hello or {}).get("capabilities"),
               "events_buffered": len(director.events), "last_seq": director.last_seq}
        if director.connected():
            out["server"] = director.request("query", "status", {}).get("body")
        return out
    if name == "director_events":
        return director.take_events(args.get("after"), float(args.get("wait_s", 0)),
                                    max(1, min(int(args.get("limit", 200)), 1000)))
    if name == "director_player":
        return director.request("query", "player", {"name": args.get("name", "")}).get("body")
    if name == "director_memory":
        q = {"npc": args.get("npc", "")}
        if args.get("player"):
            q["player"] = args["player"]
        return director.request("query", "memory", q).get("body")
    if name in ACTS:
        mtype, keys = ACTS[name]
        payload = {k: args[k] for k in keys if k in args}
        return director.request("act", mtype, payload, reason=args.get("reason"))
    raise ToolError("no such tool '%s'" % name)


def reply(msg_id, result=None, error=None):
    msg = {"jsonrpc": "2.0", "id": msg_id}
    if error is not None:
        msg["error"] = error
    else:
        msg["result"] = result
    sys.stdout.write(json.dumps(msg) + "\n")
    sys.stdout.flush()


def parse_args(argv):
    world = os.environ.get("GOANNA_DIRECTOR_WORLD", "")
    port = None
    i = 1
    while i < len(argv):
        if argv[i] == "--world" and i + 1 < len(argv):
            world = argv[i + 1]
            i += 2
        elif argv[i] == "--port" and i + 1 < len(argv):
            port = int(argv[i + 1])
            i += 2
        else:
            log("unknown argument", argv[i])
            i += 1
    return world, port


def main(argv):
    world, port_override = parse_args(argv)
    conf = os.path.join(os.path.expanduser(world), "goanna_director.conf") if world else ""
    director = Director(conf, port_override)
    port = director.reload()
    server = http.server.ThreadingHTTPServer(("127.0.0.1", port), make_handler(director))
    server.daemon_threads = True
    threading.Thread(target=server.serve_forever, daemon=True).start()
    log("listening on 127.0.0.1:%d for %s" % (port, conf or "(no world given)"))

    for line in sys.stdin:
        line = line.strip()
        if not line:
            continue
        try:
            msg = json.loads(line)
        except ValueError:
            log("ignoring a line that is not JSON")
            continue
        method = msg.get("method")
        msg_id = msg.get("id")
        params = msg.get("params") or {}
        if method == "initialize":
            asked = params.get("protocolVersion")
            reply(msg_id, {
                "protocolVersion": asked if asked in KNOWN_PROTOCOLS else PROTOCOL,
                "capabilities": {"tools": {}},
                "serverInfo": {"name": "goanna-director", "version": "0.1.0"},
            })
        elif method == "tools/list":
            reply(msg_id, {"tools": TOOLS})
        elif method == "tools/call":
            name = params.get("name", "")
            args = params.get("arguments") or {}
            try:
                result = call_tool(director, name, args)
                reply(msg_id, {"content": [{"type": "text",
                                            "text": json.dumps(result, indent=2, default=str)}]})
            except ToolError as exc:
                reply(msg_id, {"content": [{"type": "text", "text": str(exc)}], "isError": True})
            except Exception as exc:                      # noqa: BLE001
                log("%s failed: %r" % (name, exc))
                reply(msg_id, {"content": [{"type": "text",
                                            "text": "%s: %s" % (type(exc).__name__, exc)}],
                               "isError": True})
        elif method == "ping":
            reply(msg_id, {})
        elif method == "resources/list":
            reply(msg_id, {"resources": []})
        elif method == "prompts/list":
            reply(msg_id, {"prompts": []})
        elif msg_id is not None:
            reply(msg_id, error={"code": -32601, "message": "no method '%s'" % method})
    server.shutdown()
    return 0


if __name__ == "__main__":
    sys.exit(main(sys.argv))
