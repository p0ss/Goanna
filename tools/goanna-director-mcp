PROTOCOL = "2025-06-18"
KNOWN_PROTOCOLS = {"2024-11-05", "2025-03-26", PROTOCOL}
DEFAULT_PORT = 30570
EVENTS_KEPT = 4096
ACT_TIMEOUT = 15.0
CONNECTED_WITHIN = 30.0


def log(*parts):
    print("goanna-director-mcp:", *parts, file=sys.stderr, flush=True)


def read_conf(path):
    """The Settings file the mod writes: key = value lines."""
    out = {}
    try:
        text = pathlib.Path(path).read_text()
    except OSError:
        return out
    for line in text.splitlines():
        line = line.strip()
        if not line or line.startswith("#") or "=" not in line:
            continue
        key, _, value = line.partition("=")
        out[key.strip()] = value.strip()
    return out


class Director:
    """Everything shared between the HTTP endpoint and the MCP tools."""

    def __init__(self, conf_path, port_override=None):
        self.conf_path = conf_path
        self.port_override = port_override
        self.lock = threading.Condition()
        self.token = ""
        self.session = None
        self.known_session = None
        self.hello = None
        self.events = collections.deque(maxlen=EVENTS_KEPT)
        self.last_seq = 0
        self.model_seq = 0
        self.outbox = []
        self.next_id = 1
        self.results = {}
        self.late = []
        self.waiting = set()
        self.last_contact = 0.0
        self.catalogue_cache = {}
        # Tools made from the rulesets the hello advertises (ruleset_tools),
        # and who to tell when that list changes.
        self.generated = {}
        self.on_tools_changed = None
        # The file transport, when the server uses it (FileLink below).
        self.link = None
        # Message ids are this process's own. A server that last pulled
        # from another instance has acknowledged nothing of ours.
        self.instance = secrets.token_hex(8)
        self.reload()

    def reload(self):
        conf = read_conf(self.conf_path) if self.conf_path else {}
        self.token = conf.get("token", "") or os.environ.get("GOANNA_DIRECTOR_TOKEN", "")
        url = conf.get("url", "")
        port = DEFAULT_PORT
        if url:
            parsed = urllib.parse.urlparse(url)
            port = parsed.port or DEFAULT_PORT
        if self.port_override:
            port = int(self.port_override)
        return port

    def authorised(self, header):
        if not self.token:
            self.reload()
        if not self.token or not header:
            return False
        return hmac.compare_digest(header, "Bearer " + self.token)

    def connected(self):
        return time.time() - self.last_contact < CONNECTED_WITHIN

    # --- from the server -----------------------------------------------

    def on_push(self, envelope):
        with self.lock:
            self.last_contact = time.time()
            session = envelope.get("session")
            for env in envelope.get("batch") or []:
                kind = env.get("kind")
                body = env.get("body") or {}
                if kind == "hello":
                    self.on_hello(body)
                elif kind == "events":
                    for ev in body.get("events") or []:
                        ev["session"] = env.get("session")
                        self.events.append(ev)
                        self.last_seq = max(self.last_seq, int(ev.get("seq", 0)))
                elif kind in ("result", "reply"):
                    req = str(body.get("id"))
                    self.results[req] = body
                    if req not in self.waiting:
                        self.late.append(body)
            self.lock.notify_all()
            return {"known_session": session is not None and session == self.known_session}

    def on_hello(self, body):
        session = body.get("session")
        if self.known_session and session != self.known_session:
            # The server restarted. What it had not taken is void, and its
            # event sequence starts again.
            for msg in self.outbox:
                self.results[msg["req"]] = {"id": msg["req"], "type": msg["type"],
                                            "status": "interrupted",
                                            "reason": "server_restarted"}
            self.outbox = []
            if self.link:
                self.link.server_restarted(self.results)
            self.model_seq = 0
            self.last_seq = 0
            self.events.clear()
            log("the server started a new session", session)
        if not self.events or self.known_session != session:
            # A fresh director reads summaries rather than replaying what it
            # never saw: it starts from what the server last delivered.
            delivered = int(body.get("last_seq") or 0)
            self.model_seq = max(self.model_seq, delivered)
            self.last_seq = max(self.last_seq, delivered)
        self.known_session = session
        self.hello = body
        generated = ruleset_tools(body)
        changed = sorted(generated) != sorted(self.generated)
        self.generated = generated
        if changed:
            log("ruleset tools:", ", ".join(sorted(generated)) or "none")
            if self.on_tools_changed:
                self.on_tools_changed()

    def take(self, after, session, wait, instance=""):
        deadline = time.time() + max(0.0, min(wait, 25.0))
        with self.lock:
            self.last_contact = time.time()
            if session and session != self.session:
                # A server's first pull of a session is answered at once:
                # the proof in the answer is what tells it a director is
                # really here, and it tells its players so.
                self.session = session
                deadline = 0
            if instance != self.instance:
                after = 0
                deadline = 0
            self.outbox = [m for m in self.outbox if m["id"] > after]
            while not self.outbox and time.time() < deadline:
                self.lock.wait(timeout=deadline - time.time())
                self.last_contact = time.time()
            return list(self.outbox)

    # --- from the model --------------------------------------------------

    def request(self, kind, mtype, args, reason=None, timeout=ACT_TIMEOUT):
        if not self.connected():
            raise ToolError("no Luanti server has contacted this director in the last %d s. "
                            "Is the world running with goanna_director = true, "
                            "goanna_server_mod in secure.http_mods, and this url in "
                            "goanna_director.conf?" % CONNECTED_WITHIN)
        with self.lock:
            msg_id = self.next_id
            self.next_id += 1
            req = ("a%d" if kind == "act" else "q%d") % msg_id
            msg = {"id": msg_id, "req": req, "kind": kind, "type": mtype, "args": args,
                   "scope": "gm"}
            if kind == "act":
                msg["based_on"] = self.model_seq
                if reason:
                    msg["reason"] = str(reason)[:500]
            self.waiting.add(req)
            if self.link and self.link.active():
                msg["instance"] = self.instance
                self.link.send(msg)
            else:
                self.outbox.append(msg)
            self.lock.notify_all()
            deadline = time.time() + timeout
            try:
                while req not in self.results and time.time() < deadline:
                    self.lock.wait(timeout=deadline - time.time())
                body = self.results.get(req)
            finally:
                self.waiting.discard(req)
        if body is None:
            raise ToolError("the server did not answer %s within %d s; it may still apply it. "
                            "Check director_events for a late result." % (req, timeout))
        return body

    def catalogue(self, args):
        """A catalogue query, answered from the cache while the server's
        catalogue fingerprint (sent in its hello) is unchanged."""
        q = {k: args[k] for k in ("kind", "text", "group", "mod", "limit", "cursor", "detail",
                                  "hidden") if k in args}
        key = json.dumps(q, sort_keys=True)
        fingerprint = ((self.hello or {}).get("capabilities") or {}).get("catalogue")
        hit = self.catalogue_cache.get((fingerprint, key)) if fingerprint else None
        if hit is not None:
            return dict(hit, cached=True)
        body = self.request("query", "catalogue", q).get("body")
        if isinstance(body, dict) and body.get("fingerprint"):
            if len(self.catalogue_cache) > 512:
                self.catalogue_cache.clear()
            self.catalogue_cache[(body["fingerprint"], key)] = body
        return body

    def take_events(self, after, wait, limit):
        deadline = time.time() + max(0.0, min(wait, 30.0))
        with self.lock:
            if after is None:
                after = self.model_seq
            while time.time() < deadline and not any(
                    int(e.get("seq", 0)) > after for e in self.events) and not self.late:
                self.lock.wait(timeout=deadline - time.time())
            evs = [e for e in self.events if int(e.get("seq", 0)) > after][:limit]
            oldest = self.events[0]["seq"] if self.events else None
            gap = oldest is not None and after < oldest - 1
            if evs:
                self.model_seq = max(self.model_seq, int(evs[-1]["seq"]))
            late, self.late = self.late, []
            return {"session": self.known_session, "events": evs, "last_seq": self.model_seq,
                    "server_last_seq": self.last_seq, "gap": gap, "late_results": late}


class FileLink:
    """The file transport (goanna_server_mod/director/filelink.lua): the
    server and this service exchange JSON files in <world>/goanna_director/
    link. It needs nothing from the Luanti build or the operator, so it is
    what a world started from Goanna uses; HTTP stays for a server elsewhere.

    Every file is written under a name the other side ignores and then
    renamed, so neither reads half of one."""

    STALE_S = 10

    def __init__(self, director, world):
        self.director = director
        self.base = pathlib.Path(world).expanduser() / "goanna_director" / "link"
        self.inbox = self.base / "in"
        self.outbox = self.base / "out"
        self.sent = {}
        self.server_seen = 0.0
        for d in (self.inbox, self.outbox):
            d.mkdir(parents=True, exist_ok=True)
        threading.Thread(target=self._beat, daemon=True).start()
        threading.Thread(target=self._read, daemon=True).start()

    def _write(self, path, value):
        tmp = path.with_name(".%s.%d.part" % (path.name, os.getpid()))
        tmp.write_text(json.dumps(value))
        os.replace(tmp, path)

    def active(self):
        """Whether the server is talking through files right now."""
        return time.time() - self.server_seen < self.STALE_S

    def send(self, msg):
        name = "%s-%010d.json" % (msg["instance"], int(msg["id"]))
        self.sent[msg["req"]] = msg
        self._write(self.inbox / name, msg)

    def server_restarted(self, results):
        # What the old session had not read is void, as HTTP's outbox is.
        for f in self.inbox.glob("*.json"):
            try:
                f.unlink()
            except OSError:
                pass
        for req, msg in self.sent.items():
            if req not in results:
                results[req] = {"id": req, "type": msg["type"], "status": "interrupted",
                                "reason": "server_restarted"}
        self.sent.clear()

    def _beat(self):
        while True:
            try:
                self._write(self.base / "director.json",
                            {"instance": self.director.instance, "t": int(time.time()),
                             "session": self.director.known_session, "pid": os.getpid()})
            except OSError as exc:
                log("could not write the heartbeat:", exc)
            time.sleep(2)

    def _read(self):
        while True:
            try:
                hb = json.loads((self.base / "server.json").read_text())
                if abs(time.time() - float(hb.get("t", 0))) <= self.STALE_S:
                    if self.server_seen == 0 or not self.active():
                        log("the server is talking through", self.base)
                    self.server_seen = time.time()
                    with self.director.lock:
                        self.director.last_contact = time.time()
            except (OSError, ValueError):
                pass
            for f in sorted(self.outbox.glob("*.json")):
                try:
                    envelope = json.loads(f.read_text())
                    f.unlink()
                except (OSError, ValueError):
                    continue
                self.director.on_push(envelope)
                for env in envelope.get("batch") or []:
                    if env.get("kind") in ("result", "reply"):
                        self.sent.pop(str((env.get("body") or {}).get("id")), None)
            time.sleep(0.05)


class ToolError(RuntimeError):
    pass


def make_handler(director):
    class Handler(http.server.BaseHTTPRequestHandler):
        protocol_version = "HTTP/1.1"

        def log_message(self, fmt, *args):
            pass

        def send_json(self, code, value):
            data = json.dumps(value).encode()
            self.send_response(code)
            self.send_header("Content-Type", "application/json")
            self.send_header("Content-Length", str(len(data)))
            self.end_headers()
            self.wfile.write(data)

        def refuse(self, code):
            self.send_response(code)
            self.send_header("Content-Length", "0")
            self.end_headers()

        def do_POST(self):
            if not director.authorised(self.headers.get("Authorization")):
                return self.refuse(401)
            url = urllib.parse.urlparse(self.path)
            length = int(self.headers.get("Content-Length") or 0)
            raw = self.rfile.read(length) if length else b""
            if url.path != "/v1/push":
                return self.refuse(404)
            try:
                envelope = json.loads(raw or b"{}")
            except ValueError:
                return self.refuse(400)
            if envelope.get("v") != 1:
                log("a push at protocol version", envelope.get("v"), "refused")
                return self.refuse(400)
            self.send_json(200, director.on_push(envelope))

        def do_GET(self):
            if not director.authorised(self.headers.get("Authorization")):
                return self.refuse(401)
            url = urllib.parse.urlparse(self.path)
            if url.path != "/v1/pull":
                return self.refuse(404)
            q = urllib.parse.parse_qs(url.query)
            try:
                after = int(q.get("after", ["0"])[0])
                wait = float(q.get("wait", ["20"])[0])
            except ValueError:
                return self.refuse(400)
            session = q.get("session", [""])[0]
            instance = q.get("instance", [""])[0]
            messages = director.take(after, session, wait, instance)
            proof = hashlib.sha256(("%s:%s:%d" % (director.token, session, after))
                                   .encode()).hexdigest()
            self.send_json(200, {"v": 1, "messages": messages, "auth": proof,
                                 "instance": director.instance})

    return Handler


