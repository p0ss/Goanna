+float block_cloud_density(vec3 p, vec3 midpoint, vec3 half_size) {
+	float radius = min(half_size.y, half_size.x) * 0.7;
+	vec3 q = abs(p - midpoint) - (half_size - vec3(radius));
+	float sdf = length(max(q, vec3(0.0)))
