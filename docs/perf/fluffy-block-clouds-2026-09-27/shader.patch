+	float detail = texture(cloud_body_tex, p / 31.0 + vec3(0.37)).r;
+	float erosion = (1.0 - body) * radius * 0.65
+		+ (0.5 - detail) * radius * 0.3;
+	float shell = 1.0 - smoothstep(-radius * 0.8, 0.0, sdf + erosion);
+	return shell * mix(0.45, 1.0, body);
