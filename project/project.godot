; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[application]

config/name="Goanna"
run/main_scene="res://menu.tscn"
config/features=PackedStringArray("4.5", "Forward Plus")
config/icon="res://icon.svg"

[audio]

general/text_to_speech=true
driver/enable_input=true

[autoload]

Gamepad="*res://gamepad.gd"

[display]

window/size/viewport_width=1600
window/size/viewport_height=900

[rendering]

lights_and_shadows/directional_shadow/size=8192
lights_and_shadows/directional_shadow/soft_shadow_filter_quality=3
lights_and_shadows/directional_shadow/16_bits=false
lights_and_shadows/positional_shadow/soft_shadow_filter_quality=3
environment/ssao/quality=3
environment/ssao/half_size=false
environment/ssil/quality=3
environment/ssil/half_size=false
environment/volumetric_fog/volume_size=128
environment/volumetric_fog/volume_depth=96
occlusion_culling/use_occlusion_culling=true

[shader_globals]

goanna_render_water_waves={
"type": "float",
"value": 1.0
}
goanna_render_water_reflections={
"type": "float",
"value": 1.0
}
goanna_render_wet_surfaces={
"type": "float",
"value": 1.0
}
goanna_render_foliage_wind={
"type": "float",
"value": 1.0
}
goanna_render_grass_interaction={
"type": "float",
"value": 1.0
}
goanna_render_ice_detail={
"type": "float",
"value": 1.0
}
goanna_render_lava_detail={
"type": "float",
"value": 1.0
}

; Keep ice bindings registered across world changes, like the other globals.
goanna_ice_background={
"type": "sampler2D",
"value": ""
}
goanna_ice_transmission_ready={
"type": "float",
"value": 0.0
}
goanna_ice_fractures={
"type": "sampler3D",
"value": ""
}
goanna_ice_clouds={
"type": "sampler3D",
"value": ""
}

